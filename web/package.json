{
  "name": "signal-desk-web",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "The Signal Desk cockpit: a static dashboard that reads the published data branch. It places no orders.",
  "scripts": {
    "gen": "node scripts/gen-types.mjs",
    "dev": "npm run gen && vite",
    "typecheck": "npm run gen && tsc --noEmit",
    "test": "npm run gen && vitest run",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "10.24.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.9.1",
    "@testing-library/preact": "3.2.4",
    "@types/node": "20.17.10",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
