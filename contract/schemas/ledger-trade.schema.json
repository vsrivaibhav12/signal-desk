{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ledger-trade.schema.json",
  "title": "LedgerTrade",
  "description": "One settled paper trade, one line of ledger-YYYY-MM.jsonl. Written once, never edited.",
  "type": "object",
  "required": ["schema", "id", "desk", "source", "date", "symbol", "name", "instrument", "direction", "action", "qty", "entry_price", "entry_time", "status"],
  "additionalProperties": false,
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "desk": { "enum": ["index_options", "intraday_stocks", "index_futures", "mcx", "swing"] },
    "source": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "symbol": { "type": "string" },
    "name": { "type": "string" },
    "instrument": { "enum": ["stock", "index_future", "option"] },
    "direction": { "enum": [-1, 1] },
    "action": { "enum": ["BUY", "SELL"] },
    "qty": { "type": "number", "exclusiveMinimum": 0 },
    "entry_price": { "type": "number" },
    "entry_time": { "type": "string" },
    "status": { "enum": ["CLOSED", "UNRESOLVED"] },
    "risk": { "type": ["number", "null"] },
    "exit_price": { "type": ["number", "null"] },
    "exit_time": { "type": ["string", "null"] },
    "exit_type": { "type": ["string", "null"] },
    "exit_reason": { "type": ["string", "null"] },
    "gross": { "type": ["number", "null"] },
    "cost": { "type": ["number", "null"] },
    "cost_estimated": { "type": "boolean" },
    "net": { "type": ["number", "null"] },
    "r": { "type": ["number", "null"] },
    "result": { "enum": ["WIN", "LOSS", "FLAT", null] },
    "grade": { "enum": ["take", "watch", "setup", "wait", null] },
    "failed_checks": { "type": "array", "items": { "type": "string" } },
    "approved": { "type": "boolean" }
  }
}
