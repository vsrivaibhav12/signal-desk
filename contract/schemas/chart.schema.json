{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chart.schema.json",
  "title": "Chart",
  "description": "Everything needed to draw one idea: its candles, the entry, the stop, the target and the trailing line. Intraday charts use t0 and d (five-minute slots); daily charts use t (an explicit time for each candle).",
  "type": "object",
  "required": [
    "k",
    "e",
    "ep"
  ],
  "properties": {
    "t0": {
      "type": "integer"
    },
    "d": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "t": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "unit": {
      "enum": [
        "m5",
        "day"
      ]
    },
    "k": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4
      }
    },
    "e": {
      "type": "integer",
      "minimum": 0
    },
    "x": {
      "type": [
        "integer",
        "null"
      ]
    },
    "ep": {
      "type": "number"
    },
    "xp": {
      "type": [
        "number",
        "null"
      ]
    },
    "ln": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 2,
        "maxItems": 2
      }
    },
    "ov": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "bx": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "minItems": 5,
      "maxItems": 5
    },
    "st": {
      "type": [
        "number",
        "null"
      ]
    },
    "tg": {
      "type": [
        "number",
        "null"
      ]
    },
    "dir": {
      "enum": [
        -1,
        1,
        null
      ]
    },
    "sc": {
      "type": "boolean"
    },
    "tr": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "label",
            "v"
          ],
          "properties": {
            "label": {
              "type": "string"
            },
            "v": {
              "type": "array",
              "items": {
                "type": [
                  "number",
                  "null"
                ]
              }
            }
          }
        }
      ]
    },
    "tn": {
      "type": "string"
    },
    "el": {
      "type": "string"
    }
  }
}
