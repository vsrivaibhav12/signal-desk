# Copy to /etc/signal-desk.env and chmod 600 it.
# GitHub fine-grained PAT: Contents read/write on this repository.
GITHUB_TOKEN=replace_with_repository_token
GITHUB_REPOSITORY=OWNER/REPOSITORY

# Enables local status/trade/impact publication coordination between services.
SIGNAL_DESK_SHARED_DATA=1
SIGNAL_DESK_SUPERVISOR=1

# Optional: without this the scanner uses deterministic rules only.
OPENAI_API_KEY=

# Optional Telegram alert delivery for high-impact events. Keep the same bot/chat
# used by the trade engine, or supply TELEGRAM_CHAT_ID explicitly.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PAIRING_CODE=

# Primary NSE/BSE provider and secondary MCX provider.
KOTAK_CONSUMER_KEY=
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_PIN=
